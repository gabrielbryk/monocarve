# dependencies
node_modules/

# build output
dist/
artifacts/
*.tsbuildinfo

# tool scratch space (worktrees, simulation roots, generated plans under test)
.monocarve/
tmp/
*.log
# ad hoc local backups; not tool-managed, but the same kind of scratch
.cache/

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# env
.env
.env.*
!.env.example

# sibling worktrees from `wt switch -c`. Only the global gitignore listed
# these, which git honours but oxlint/oxfmt do not read - so a lint or format
# run from the main checkout walked every sibling branch and re-reported its
# findings as unbaselined.
.worktrees/
